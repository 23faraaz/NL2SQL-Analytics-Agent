# Example identifiers and non-secret operational settings only.
# Never commit credentials, secret values, or a real production tfvars file.

public_subnets = {
  public-a = {
    cidr_block        = "10.20.0.0/24"
    availability_zone = "eu-west-2a"
  }
  public-b = {
    cidr_block        = "10.20.1.0/24"
    availability_zone = "eu-west-2b"
  }
}

private_subnets = {
  private-a = {
    cidr_block        = "10.20.10.0/24"
    availability_zone = "eu-west-2a"
  }
  private-b = {
    cidr_block        = "10.20.11.0/24"
    availability_zone = "eu-west-2b"
  }
}

nat_gateway_subnet_key = "public-a"
certificate_arn        = "arn:aws:acm:eu-west-2:123456789012:certificate/REPLACE_ME"

# Supply image_uri from CI/CD, not this file:
# TF_VAR_image_uri=123456789012.dkr.ecr.eu-west-2.amazonaws.com/nl2sql-agent@sha256:...
# TF_VAR_importer_image_uri=123456789012.dkr.ecr.eu-west-2.amazonaws.com/nl2sql-agent@sha256:...

# Supply only the ARN of a separately populated secret. Terraform must not
# receive the provider API key value.
application_secret_arn = "arn:aws:secretsmanager:eu-west-2:123456789012:secret:REPLACE_ME"
database_application_secret_arn = "arn:aws:secretsmanager:eu-west-2:123456789012:secret:REPLACE_ME"

database_instance_class       = "db.t4g.micro"
database_multi_az             = false
database_backup_retention_days = 7
desired_count                 = 0 # bootstrap run; use 2 only after migration succeeds
log_retention_days            = 30
monthly_budget_usd             = 75
github_production_subject      = "repo:OWNER@OWNER_ID/REPOSITORY@REPOSITORY_ID:environment:production"
