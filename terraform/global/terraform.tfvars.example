# Use the exact subject emitted by this repository's GitHub OIDC token.
# Standard subject format for a main-branch job without a GitHub Environment:
github_oidc_subject = "repo:OWNER/REPOSITORY:ref:refs/heads/main"

# Environment jobs receive an environment subject rather than a branch subject.
github_production_subject = "repo:OWNER@OWNER_ID/REPOSITORY@REPOSITORY_ID:environment:production"

terraform_state_bucket_name = "REPLACE_WITH_BOOTSTRAP_STATE_BUCKET"
terraform_state_kms_key_arn  = "arn:aws:kms:eu-west-2:123456789012:key/REPLACE_ME"

# Repositories using GitHub immutable subject claims use owner/repository IDs:
# github_oidc_subject = "repo:OWNER@OWNER_ID/REPOSITORY@REPOSITORY_ID:ref:refs/heads/main"
