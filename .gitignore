# Python
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*
!.env.example

# -----------------------------
# ETL Data
# -----------------------------
data/raw/*
data/processed/*
data/generated/*

# Keep directory structure
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep
!data/generated/.gitkeep

