# Copy this file to .env and fill in real values. .env is gitignored.

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Used by app/db.py, scripts/load_commerce.py, and docker-compose.yml.
# DATABASE_URL, if set, takes priority over the individual DB_* values
# below. POSTGRES_* names are also accepted as fallbacks (the official
# postgres Docker image's own variable names).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nl2sql_ecommerce
DB_USER=nl2sql_app
DB_PASSWORD=change-me
# DATABASE_URL=postgresql://nl2sql_app:change-me@localhost:5432/nl2sql_ecommerce

# ---------------------------------------------------------------------
# LLM provider selection. "gemini" or "groq"; unset defaults to
# "gemini". Only the selected provider's own variables below need to be
# set -- switching providers never requires an application code change.
# See app/llm/factory.py.
# ---------------------------------------------------------------------
# LLM_PROVIDER=gemini

# ---------------------------------------------------------------------
# Gemini (required when LLM_PROVIDER=gemini -- the app fails fast at
# startup if either is unset; see app/llm/gemini_provider.py:validate_config())
# ---------------------------------------------------------------------
GEMINI_API_KEY=your-real-gemini-api-key
# No default is provided deliberately -- set this to a model ID valid
# for your own Gemini API access; check the current Gemini API model
# list rather than assuming a name here is still valid.
GEMINI_MODEL=your-gemini-model-id
GEMINI_MAX_TOKENS=2048
GEMINI_MAX_ATTEMPTS=4

# ---------------------------------------------------------------------
# Groq (required when LLM_PROVIDER=groq -- the app fails fast at
# startup if either is unset; see app/llm/groq_provider.py:validate_config())
# ---------------------------------------------------------------------
GROQ_API_KEY=your-real-groq-api-key
# openai/gpt-oss-20b is recommended: as of this writing it's one of only
# two Groq models supporting strict-mode JSON Schema structured outputs
# (constrained decoding, not just "valid JSON") -- see
# console.groq.com/docs/structured-outputs -- and the faster of the two,
# with a 128K context window. Check Groq's current model list before
# relying on this long-term; model availability changes.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=2048
GROQ_MAX_ATTEMPTS=4
# On Groq's free/on-demand tier, openai/gpt-oss-20b is capped at 8,000
# tokens/minute -- verified in practice: a burst of ~3 consecutive
# NL2SQL requests (full schema + metadata in the prompt) can exhaust it
# within a minute. The default 10s rate-limit delay cap
# (GEMINI_RATE_LIMIT_MAX_DELAY_SECONDS's Groq equivalent) is too short to
# wait out that window, so requests fail fast instead of recovering.
# Raise this if you'd rather the app wait out a real token-limit reset
# (observed ~37s) than fail immediately -- trades UI responsiveness for
# fewer hard failures. Leave unset (10s default) to keep failing fast.
GROQ_RATE_LIMIT_MAX_DELAY_SECONDS=60
# Also raise this (default 2) if you see back-to-back 429s in quick
# succession under bursty use -- observed in practice: a second 429 can
# follow the first with only a few seconds' suggested wait, well within
# the delay cap above, but still fail if the attempt budget is already
# exhausted. Normal single-question usage is unlikely to need this.
GROQ_RATE_LIMIT_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------
# ETL synthetic augmentation (S4b) -- all optional, sensible defaults
# apply if unset. See etl/augment/config.py.
# ---------------------------------------------------------------------
# ETL_AUGMENTATION_SEED=42
# ETL_MIN_VARIANTS_PER_PRODUCT=1
# ETL_MAX_VARIANTS_PER_PRODUCT=3
# ETL_MIN_MARKUP_MULTIPLIER=1.4
# ETL_MAX_MARKUP_MULTIPLIER=2.5
