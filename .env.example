# Copy this file to .env and fill in real values. .env is gitignored.

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Used by app/db.py, scripts/load_commerce.py, and docker-compose.yml.
# DATABASE_URL, if set, takes priority over the individual DB_* values
# below. POSTGRES_* names are also accepted as fallbacks (the official
# postgres Docker image's own variable names).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nl2sql_ecommerce
DB_USER=nl2sql_app
DB_PASSWORD=change-me
# DATABASE_URL=postgresql://nl2sql_app:change-me@localhost:5432/nl2sql_ecommerce

# ---------------------------------------------------------------------
# Gemini (required -- the app fails fast at startup if either is unset;
# see app/llm.py:validate_config())
# ---------------------------------------------------------------------
GEMINI_API_KEY=your-real-gemini-api-key
# No default is provided deliberately -- set this to a model ID valid
# for your own Gemini API access; check the current Gemini API model
# list rather than assuming a name here is still valid.
GEMINI_MODEL=your-gemini-model-id
GEMINI_MAX_TOKENS=2048
GEMINI_MAX_ATTEMPTS=4

# ---------------------------------------------------------------------
# ETL synthetic augmentation (S4b) -- all optional, sensible defaults
# apply if unset. See etl/augment/config.py.
# ---------------------------------------------------------------------
# ETL_AUGMENTATION_SEED=42
# ETL_MIN_VARIANTS_PER_PRODUCT=1
# ETL_MAX_VARIANTS_PER_PRODUCT=3
# ETL_MIN_MARKUP_MULTIPLIER=1.4
# ETL_MAX_MARKUP_MULTIPLIER=2.5
